    <TIER ANNOTATOR="k1rjje" LANG_REF="rus"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@dnv2007f" PARTICIPANT="@dnv2007f" TIER_ID="gestComment@dnv2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2118" ANNOTATION_REF="a2087">
                <ANNOTATION_VALUE>Присутствует всё время, когда не исполняются другие жесты. Поднятие головы связано с последующим жестом.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2639" ANNOTATION_REF="a2093">
                <ANNOTATION_VALUE>также, изобразительный: движение машины</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2119" ANNOTATION_REF="a2094">
                <ANNOTATION_VALUE>поднимает руку при введении новой информации, дополнительные движения помогают контролировать темп</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2120" ANNOTATION_REF="a2098">
                <ANNOTATION_VALUE>в значении 'забыть, оставить'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2146" ANNOTATION_REF="a2132">
                <ANNOTATION_VALUE>заполненная пауза????</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2158" ANNOTATION_REF="a2147">
                <ANNOTATION_VALUE>'ну ты понял? / очевидно же?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2159" ANNOTATION_REF="a2149">
                <ANNOTATION_VALUE>нести (?)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2237" ANNOTATION_REF="a2168">
                <ANNOTATION_VALUE>также может служить для поддержания темпа</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2238" ANNOTATION_REF="a2169">
                <ANNOTATION_VALUE>изменение, противопоставление новой информации старой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2239" ANNOTATION_REF="a2171">
                <ANNOTATION_VALUE>обозначение группы 1PL. Возможно, ненамеренный разворот руки перед следующим жестом.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2240" ANNOTATION_REF="a2172">
                <ANNOTATION_VALUE>также 'ехать вперёд'. Сливается с прошлым сегментом.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2241" ANNOTATION_REF="a2174">
                <ANNOTATION_VALUE>также, 'двигаться вперёд вверх'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2640" ANNOTATION_REF="a2175">
                <ANNOTATION_VALUE>также возможно изобразительный: возвышенность (рука раскрывается, показывая форму холма; ассимилируется с указательным жестом местоположения)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2242" ANNOTATION_REF="a2180">
                <ANNOTATION_VALUE>также, 'сжатие пакета'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2243" ANNOTATION_REF="a2185">
                <ANNOTATION_VALUE>также, "брось!/перестань!". отчасти изобразительный, как передача действий другого лица</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2255" ANNOTATION_REF="a2246">
                <ANNOTATION_VALUE>также, вперёд внутрь. явно выражена первая фаза, когда субъект (машина) "ставится" в пространстве</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2268" ANNOTATION_REF="a2256">
                <ANNOTATION_VALUE>когда субъект (информант) "ставится" в пространстве.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2373" ANNOTATION_REF="a2278">
                <ANNOTATION_VALUE>удивление + подчёркивание фразы (необычности контекста)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2374" ANNOTATION_REF="a2284">
                <ANNOTATION_VALUE>на фоне смеха</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2375" ANNOTATION_REF="a2286">
                <ANNOTATION_VALUE>при эмоциональной разрядке</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2376" ANNOTATION_REF="a2288">
                <ANNOTATION_VALUE>также, "круто!"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2377" ANNOTATION_REF="a2289">
                <ANNOTATION_VALUE>отчасти изобразительный: сердечко, но является типичным жестом со значением "нравится"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2378" ANNOTATION_REF="a2293">
                <ANNOTATION_VALUE>эмфаза на "тоже"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2379" ANNOTATION_REF="a2294">
                <ANNOTATION_VALUE>также в последующих сегментах</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2411" ANNOTATION_REF="a2381">
                <ANNOTATION_VALUE>начинается в конце предыдущего жеста в другой руке</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2412" ANNOTATION_REF="a2384">
                <ANNOTATION_VALUE>неопределённость действия, действие общего характера, понятное из контекста</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2413" ANNOTATION_REF="a2385">
                <ANNOTATION_VALUE>также выделение перечисленных элементов, градация (по странности)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2476" ANNOTATION_REF="a2439">
                <ANNOTATION_VALUE>возможно отчасти форма, т. к. показывается углубление формой руки ср.палец ~ 'ы'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2477" ANNOTATION_REF="a2441">
                <ANNOTATION_VALUE>также прагматический:контролировать темп речи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2491" ANNOTATION_REF="a2478">
                <ANNOTATION_VALUE>возможно, протеза перед следующим жестом (???)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2531" ANNOTATION_REF="a2492">
                <ANNOTATION_VALUE>также в сл. жесте</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2532" ANNOTATION_REF="a2500">
                <ANNOTATION_VALUE>изображается свечение сверху, над городом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2653" ANNOTATION_REF="a2501">
                <ANNOTATION_VALUE>также, 'ожидание'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2547" ANNOTATION_REF="a2533">
                <ANNOTATION_VALUE>жест останавливается, когда информантка начинает подбирать слова</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2548" ANNOTATION_REF="a2535">
                <ANNOTATION_VALUE>также возможно указательный:местоположение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2626" ANNOTATION_REF="a2586">
                <ANNOTATION_VALUE>обращение к перфектному действию в недавнем прошлом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2666" ANNOTATION_REF="a2654">
                <ANNOTATION_VALUE>рука показывает число 2</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2667" ANNOTATION_REF="a2656">
                <ANNOTATION_VALUE>слово найдено</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
